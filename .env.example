# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/interviewos?schema=public"

# ─── Backend ─────────────────────────────────────────────────────────────────
PORT=3001
BACKEND_URL="http://localhost:3001"
JWT_SECRET="change-me-to-a-random-64-char-string"

# ─── Redis (required for Socket.IO horizontal scaling) ──────────────────────
# Set REDIS_URL="" to run single-instance without Redis
REDIS_URL="redis://localhost:6379"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=30

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log levels: trace | debug | info | warn | error | fatal | silent
# Default: debug (development) | info (production)
LOG_LEVEL=info

# ─── Frontend ────────────────────────────────────────────────────────────────
# Socket URL is derived from NEXT_PUBLIC_API_URL (strips /api suffix)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
FRONTEND_URL="http://localhost:3000"
# Set to "true" to use the in-app mock API routes (dev without backend).
# Leave unset to proxy /api/* to the real backend via API_DEST_URL / NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_USE_MOCK_API="true"
# Set to "true" to use the in-app mock API routes (dev without backend).
# Leave unset to proxy /api/* to the real backend via API_DEST_URL / NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_USE_MOCK_API="true"

# ─── OAuth (set to enable Google/GitHub Sign-In) ────────────────────────────
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# ─── Sentry Error Monitoring ──────────────────
# DSN for client-side (Next.js browser). Get from sentry.io → Settings → Projects → Your Project → DSN
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# DSN for server-side (Next.js server + NestJS backend). Same DSN can be used for both.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Sentry Auth Token (for source map uploads during build)
# Generate at sentry.io → Settings → Auth Tokens → Create New Token (scopes: project:releases, project:write)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ─── AI Integrations ─────────────────────────────────────────────────────────
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"   # Get from https://resend.com
FROM_EMAIL="noreply@interviewos.app"

# ─── WebRTC TURN (optional) ─────────────────────────────────────────────────
# TURN_URL=""
# TURN_USERNAME=""
# TURN_CREDENTIAL=""

# ─── Cloud Storage ──────────────────────────────────────────────────────────
STORAGE_PROVIDER="local"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="ap-southeast-1"
# AWS_S3_BUCKET=""
# GCS_BUCKET=""
# GCS_PROJECT_ID=""
# GCS_CLIENT_EMAIL=""
# GCS_PRIVATE_KEY=""